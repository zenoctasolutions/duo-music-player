<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-up dark gradient so white text/buttons stay readable over any cover. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="90" android:startColor="#DD000000" android:centerColor="#66000000" android:endColor="#00000000" />
    <corners android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp" />
</shape>
